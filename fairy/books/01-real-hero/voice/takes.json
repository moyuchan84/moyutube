[
 {
  "id": "s01-0",
  "scene": 1,
  "voices": [
   "준이"
  ],
  "lines": [
   {
    "who": "준이",
    "t": "나는 준이야. 나는 매일 밤 망토를 입고 잠들어. 왜냐하면… 나는 곧 세상을 구할 히어로가 될 거니까!"
   }
  ]
 },
 {
  "id": "s02-0",
  "scene": 2,
  "voices": [
   "narr",
   "준이"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "준이는 오늘도 망토를 잊지 않습니다."
   },
   {
    "who": "준이",
    "t": "학교 갈 때도 망토는 필수! 슈우우웅!"
   }
  ]
 },
 {
  "id": "s03-0",
  "scene": 3,
  "voices": [
   "narr",
   "준이"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "급식시간 종이 울리고,"
   },
   {
    "who": "narr",
    "t": "준이는 망토를 휘날리며 급하게 뛰어갑니다."
   },
   {
    "who": "준이",
    "t": "지구를 지키려면 에너지를 많이 축적해야 해. 내가 제일 먼저다! 슈우우웅!"
   }
  ]
 },
 {
  "id": "s03-1",
  "scene": 3,
  "voices": [
   "친구",
   "준이"
  ],
  "lines": [
   {
    "who": "친구",
    "t": "야, 우리 다 기다리고 있었잖아…"
   },
   {
    "who": "준이",
    "t": "히어로는 원래 빠른 법!"
   }
  ]
 },
 {
  "id": "s04-0",
  "scene": 4,
  "voices": [
   "narr",
   "준이"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "준이가 보드게임을 밀치며 울음을 터뜨려요."
   },
   {
    "who": "준이",
    "t": "으아앙! 내가 지다니 말도 안 되잖아! 다시 해! 이 게임은 무효야!"
   }
  ]
 },
 {
  "id": "s05-0",
  "scene": 5,
  "voices": [
   "narr",
   "준이"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "준이 곁에는 아무도 오지 않습니다."
   },
   {
    "who": "narr",
    "t": "텅 빈 놀이터 그네에 혼자 앉아,"
   },
   {
    "who": "narr",
    "t": "저 멀리 친구들이 웃으며 노는 소리를 듣습니다."
   },
   {
    "who": "준이",
    "t": "다들...나만 빼고 재밌나 봐."
   }
  ]
 },
 {
  "id": "s06-0",
  "scene": 6,
  "voices": [
   "narr",
   "준이"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "그때 그네 반대쪽에서 우는 소리가 들렸어요."
   },
   {
    "who": "narr",
    "t": "선호가 목발을 짚다가 넘어져 무릎을 다쳤어요."
   },
   {
    "who": "narr",
    "t": "준이가 두 팔을 뻗고 눈에 힘을 줬지만, 아무 일도 일어나지 않았어요."
   },
   {
    "who": "준이",
    "t": "내가 구해줄게! 상처를 낫게 하는 레이저 발사!!"
   }
  ]
 },
 {
  "id": "s07-0",
  "scene": 7,
  "voices": [
   "narr",
   "민지"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "그때 민지가 달려와 선호 옆에 앉았어요."
   },
   {
    "who": "narr",
    "t": "민지는 선호가 일어날 때까지 몸을 낮추고 기다려줬어요."
   },
   {
    "who": "narr",
    "t": "선호가 민지 어깨를 짚고 겨우 일어섰어요."
   },
   {
    "who": "민지",
    "t": "선호야, 많이 아프겠다..천천히 일어나. 내가 잡아줄게."
   }
  ]
 },
 {
  "id": "s07-1",
  "scene": 7,
  "voices": [
   "선호"
  ],
  "lines": [
   {
    "who": "선호",
    "t": "고마워, 민지야."
   }
  ]
 },
 {
  "id": "s08-0",
  "scene": 8,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "선생님이 오셔서 민지를 칭찬했고, 친구들은 박수를 쳤어요."
   },
   {
    "who": "narr",
    "t": "이상했어요."
   },
   {
    "who": "narr",
    "t": "민지는 레이저도, 초능력도 없는데 모두가 좋아했어요."
   },
   {
    "who": "narr",
    "t": "지구를 구하지도 않았는데. 망토도 없는데."
   },
   {
    "who": "narr",
    "t": "마치… 히어로 같았어요."
   }
  ]
 },
 {
  "id": "s09-0",
  "scene": 9,
  "voices": [
   "narr",
   "준이"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "준이는 축 처진 자신의 망토를 내려다봤어요."
   },
   {
    "who": "준이",
    "t": "도대체… 어떻게 해야 사람들이 좋아하는 히어로가 될 수 있는 거야?"
   }
  ]
 },
 {
  "id": "s10-0",
  "scene": 10,
  "voices": [
   "narr",
   "민지"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "준이는 그날부터 작은 공책을 들고 다니며"
   },
   {
    "who": "narr",
    "t": "민지를 몰래몰래 지켜봤어요."
   },
   {
    "who": "narr",
    "t": "등교할 때 먼저 인사하는 민지"
   },
   {
    "who": "narr",
    "t": "발표할 때 손 들고 기다리는 민지"
   },
   {
    "who": "narr",
    "t": "지는 팀에게도 웃으며 박수쳐주는 민지"
   },
   {
    "who": "narr",
    "t": "준이는 하나씩 공책에 그림으로 그려 넣었어요."
   },
   {
    "who": "민지",
    "t": "준아, 너 요즘 왜 자꾸 나 쳐다봐?"
   }
  ]
 },
 {
  "id": "s10-1",
  "scene": 10,
  "voices": [
   "준이"
  ],
  "lines": [
   {
    "who": "준이",
    "t": "아, 아니야! 그냥.."
   }
  ]
 },
 {
  "id": "s11-0",
  "scene": 11,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "며칠 뒤, 체육 시간에 피구 경기가 열렸어요."
   },
   {
    "who": "narr",
    "t": "준이네 팀이 지고 말았어요."
   },
   {
    "who": "narr",
    "t": "몇몇 친구들은 억울해하며 씩씩거렸어요."
   },
   {
    "who": "narr",
    "t": "준이는 잠깐 망설였어요."
   },
   {
    "who": "narr",
    "t": "예전 같으면 \"그럴 리가 없어! 다시 해!\" 하고 소리쳤을 텐데."
   }
  ]
 },
 {
  "id": "s12-0",
  "scene": 12,
  "voices": [
   "narr",
   "준이"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "준이는 숨을 한 번 크게 쉬고, 이긴 팀 쪽으로 걸어갔어요."
   },
   {
    "who": "narr",
    "t": "교실이 조용해졌어요."
   },
   {
    "who": "narr",
    "t": "친구들이 준이를 쳐다봤어요."
   },
   {
    "who": "narr",
    "t": "민지도요."
   },
   {
    "who": "준이",
    "t": "너네 아까 진짜 잘하더라...축하해!"
   }
  ]
 },
 {
  "id": "s13-0",
  "scene": 13,
  "voices": [
   "narr",
   "준이"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "급식 시간, 줄이 길게 늘어서 있었어요."
   },
   {
    "who": "narr",
    "t": "준이는 맨 앞으로 뛰어가려다...멈칫하고, 뒤로 가서 섰어요."
   },
   {
    "who": "narr",
    "t": "선호가 목발을 짚고 천천히 걸어오자, 준이가 먼저 자리를 비켜줬어요."
   },
   {
    "who": "준이",
    "t": "선호야, 내 앞에 서. 천천히 와도 돼."
   }
  ]
 },
 {
  "id": "s13-1",
  "scene": 13,
  "voices": [
   "선호",
   "준이"
  ],
  "lines": [
   {
    "who": "선호",
    "t": "어… 고마워, 준아. 우리 밥 같이 먹을래?"
   },
   {
    "who": "준이",
    "t": "어? 그..그래! 좋아!"
   }
  ]
 },
 {
  "id": "s14-0",
  "scene": 14,
  "voices": [
   "narr",
   "준이"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "그날 밤, 준이는 공책을 펼쳤어요."
   },
   {
    "who": "narr",
    "t": "공책 안에는 준이가 그린 히어로 배지가 하나둘 늘어가고 있었어요."
   },
   {
    "who": "narr",
    "t": "준이는 망토를 벗어 곱게 공책 옆에 올려놓고,"
   },
   {
    "who": "narr",
    "t": "창밖 달을 보며 말했어요."
   },
   {
    "who": "준이",
    "t": "나… 오늘 조금은 히어로였던 것 같아."
   }
  ]
 },
 {
  "id": "s15-0",
  "scene": 15,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "준이는 내일도 망토를 입을까요?"
   },
   {
    "who": "narr",
    "t": "아마도요."
   },
   {
    "who": "narr",
    "t": "하지만 이제는 알아요."
   },
   {
    "who": "narr",
    "t": "진짜 힘은 망토가 아니라,"
   },
   {
    "who": "narr",
    "t": "그 안의 마음이라는 걸요."
   }
  ]
 }
]