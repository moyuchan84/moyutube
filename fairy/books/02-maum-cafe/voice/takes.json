[
 {
  "id": "s00-0",
  "scene": 0,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "마음카페에 내 마음을 털어놓으면 마법레시피 동전이 생겨요."
   },
   {
    "who": "narr",
    "t": "어떤 마음이라도 맛있는 디저트 재료가 될 수 있답니다."
   }
  ]
 },
 {
  "id": "s01-0",
  "scene": 1,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "마음을 알아주는 마법레시피가 있는 마음카페에 오신 것을 환영해요."
   }
  ]
 },
 {
  "id": "s02-0",
  "scene": 2,
  "voices": [
   "나무늘보"
  ],
  "lines": [
   {
    "who": "나무늘보",
    "t": "아, 느려 느려 왜 이렇게 느려! 빨리 빨리 선생님이 자꾸 가만히 있으라고 해요! 자꾸 나만 혼내고! 난 더 빨리 움직이고 싶은데!!"
   }
  ]
 },
 {
  "id": "s03-0",
  "scene": 3,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "이런, 이런 그동안 답답하고 속상했겠는걸."
   }
  ]
 },
 {
  "id": "s04-0",
  "scene": 4,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "마음환전기계에 이 동전을 한 번 넣어보렴."
   }
  ]
 },
 {
  "id": "s05-0",
  "scene": 5,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "이번 마음 재료로는 어떤 맛이 만들어지려나?"
   },
   {
    "who": "바라",
    "t": "지금은 그냥 물이지만, 얼음이 모두 녹을 때까지 기다리면, 무지개 빛 색 주스가 된단다. 7가지 색이 다 나오면 무슨 맛인지 궁금한 걸"
   }
  ]
 },
 {
  "id": "s06-0",
  "scene": 6,
  "voices": [
   "나무늘보"
  ],
  "lines": [
   {
    "who": "나무늘보",
    "t": "먹고 싶어 먹고 싶다!! 아직 주황색이야!! 얼음 몇 개나 더 남은거야!!"
   }
  ]
 },
 {
  "id": "s07-0",
  "scene": 7,
  "voices": [
   "나무늘보"
  ],
  "lines": [
   {
    "who": "나무늘보",
    "t": "오오!! 우아!!! 무지개다!! 이런 맛은 처음이야!!!"
   }
  ]
 },
 {
  "id": "s08-0",
  "scene": 8,
  "voices": [
   "사자"
  ],
  "lines": [
   {
    "who": "사자",
    "t": "다들..자꾸..나만 보면..도망가요...나는 놀고 싶었던 것 뿐인데..흑.."
   }
  ]
 },
 {
  "id": "s09-0",
  "scene": 9,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "이런, 그동안 너무 외로웠겠는걸."
   },
   {
    "who": "바라",
    "t": "마음환전기계에 이 동전을 한 번 넣어보겠니?"
   }
  ]
 },
 {
  "id": "s10-0",
  "scene": 10,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "이번 마음 재료로는 어떤 맛이 만들어지려나?"
   },
   {
    "who": "바라",
    "t": "사자야, 여기 용기팝콘을 받으렴. 용기를 낼수록 팝콘은 팡팡 늘어 날거야."
   }
  ]
 },
 {
  "id": "s11-0",
  "scene": 11,
  "voices": [
   "사자"
  ],
  "lines": [
   {
    "who": "사자",
    "t": "이..거..한..번.. 먹어 볼래? 팝..콘인데.."
   }
  ]
 },
 {
  "id": "s12-0",
  "scene": 12,
  "voices": [
   "사자"
  ],
  "lines": [
   {
    "who": "사자",
    "t": "여기 아직 내게 남은 팝콘이 많아. 맛있지?"
   }
  ]
 },
 {
  "id": "s12-1",
  "scene": 12,
  "voices": [
   "다람쥐"
  ],
  "lines": [
   {
    "who": "다람쥐",
    "t": "고마워 너무 고소해"
   },
   {
    "who": "다람쥐",
    "t": "나도 줘. 나도 줘"
   },
   {
    "who": "다람쥐",
    "t": "사자야, 너도 같이 먹자"
   }
  ]
 },
 {
  "id": "s13-0",
  "scene": 13,
  "voices": [
   "고슴도치"
  ],
  "lines": [
   {
    "who": "고슴도치",
    "t": "엄마도 밉고, 형도 밉고, 다 미워.. 맨날 나만 잘못했다고 하고..이번엔 진짜 내가 망가트린 거 아닌데.."
   }
  ]
 },
 {
  "id": "s14-0",
  "scene": 14,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "이런, 이런 얼마나 억울하고 슬펐을까.."
   }
  ]
 },
 {
  "id": "s14-1",
  "scene": 14,
  "voices": [
   "고슴도치"
  ],
  "lines": [
   {
    "who": "고슴도치",
    "t": "그런데요, 미워하면 안 되는 거잖아요. 이런 나쁜 마음도 받아주시나요?"
   }
  ]
 },
 {
  "id": "s15-0",
  "scene": 15,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "도치야. 이 세상에 나쁜 마음은 없단다. 도치가 지금 느끼는 감정은 그렇게 느낄만한 이유가 있는 거지. 마음환전기계에 이 동전을 한 번 넣어볼까?"
   },
   {
    "who": "바라",
    "t": "이번 마음 재료로는 어떤 맛이 만들어지려나?"
   }
  ]
 },
 {
  "id": "s16-0",
  "scene": 16,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "너의 마음을 안아줄 폭신폭신 솜사탕 파르페란다. 아무리 뾰족한 마음이어도 모두 품어줄 거야."
   }
  ]
 },
 {
  "id": "s16-1",
  "scene": 16,
  "voices": [
   "고슴도치"
  ],
  "lines": [
   {
    "who": "고슴도치",
    "t": "아, 포근해. 기분이 폭신폭신 편안해졌어!"
   }
  ]
 },
 {
  "id": "s17-0",
  "scene": 17,
  "voices": [
   "카멜레온"
  ],
  "lines": [
   {
    "who": "카멜레온",
    "t": "내일 이사를 가는데요. 처음 가보는 숲이 너무 무서운 데, 궁금하기도 해요. 새로운 친구들 만나는 게 설레기도 하는데, 숨고 싶기도 하고.. 아무래도 제가 이상한 것 같아요."
   }
  ]
 },
 {
  "id": "s18-0",
  "scene": 18,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "이런, 동시에 여러 마음이 느껴져서 마음이 어지러웠구나. 하지만, 마음의 색이 꼭 한가지일 필요는 없단다. 나도 손님을 만나는 게 기쁘면서도 쉬고 싶을 때가 있거든. 마음환전기계에 이 동전을 한 번 넣어볼래?"
   }
  ]
 },
 {
  "id": "s19-0",
  "scene": 19,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "이번 마음 재료로는 어떤 맛이 만들어지려나?"
   },
   {
    "who": "바라",
    "t": "여러 마음이 담겨 세상에 하나 뿐인 멋진 색이 되었네? 자, 여기 알록달록 회오리 막대사탕 한번 먹어보렴."
   }
  ]
 },
 {
  "id": "s20-0",
  "scene": 20,
  "voices": [
   "카멜레온"
  ],
  "lines": [
   {
    "who": "카멜레온",
    "t": "와! 너무 예쁘다. 내 마음이 이렇게 예쁜 색이었다니! 달콤해! 맛있어!"
   }
  ]
 },
 {
  "id": "s21-0",
  "scene": 21,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "‘마음카페 사장님은 지금 휴가 중입니다.’"
   }
  ]
 },
 {
  "id": "s21-1",
  "scene": 21,
  "voices": [
   "토끼"
  ],
  "lines": [
   {
    "who": "토끼",
    "t": "이게 뭐야! 안 그래도 아빠가 나랑 놀아준다고 해놓고 약속을 지키지 않아서 속상한데! 으앙!"
   }
  ]
 },
 {
  "id": "s22-0",
  "scene": 22,
  "voices": [
   "사자"
  ],
  "lines": [
   {
    "who": "사자",
    "t": "토끼였구나! 괜찮아! 어서 들어와!"
   }
  ]
 },
 {
  "id": "s23-0",
  "scene": 23,
  "voices": [
   "카멜레온"
  ],
  "lines": [
   {
    "who": "카멜레온",
    "t": "사장님 대신 우리가 마음카페를 지키고 있어."
   }
  ]
 },
 {
  "id": "s23-1",
  "scene": 23,
  "voices": [
   "나무늘보"
  ],
  "lines": [
   {
    "who": "나무늘보",
    "t": "바라 사장님처럼 마법레시피는 없지만, 우리가 조금씩 가지고 온 걸로 만든 거야."
   }
  ]
 },
 {
  "id": "s23-2",
  "scene": 23,
  "voices": [
   "토끼"
  ],
  "lines": [
   {
    "who": "토끼",
    "t": "화채잖아. 내가 좋아하는 사과도 있어! 애들아, 고마워!"
   }
  ]
 },
 {
  "id": "s24-0",
  "scene": 24,
  "voices": [
   "고슴도치"
  ],
  "lines": [
   {
    "who": "고슴도치",
    "t": "우리가 만들었지만 진짜 맛있네."
   }
  ]
 },
 {
  "id": "s24-1",
  "scene": 24,
  "voices": [
   "사자"
  ],
  "lines": [
   {
    "who": "사자",
    "t": "그런데 바라 사장님은 언제 오시지?"
   }
  ]
 },
 {
  "id": "s24-2",
  "scene": 24,
  "voices": [
   "나무늘보"
  ],
  "lines": [
   {
    "who": "나무늘보",
    "t": "사장님 보고 싶다."
   }
  ]
 },
 {
  "id": "s25-0",
  "scene": 25,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "애들아, 내가 돌아왔어! 세상에, 여기 있었네. 진짜 마법레시피가!"
   }
  ]
 },
 {
  "id": "s26-0",
  "scene": 26,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "마음카페에 또 놀러오세요. 어떤 마음이든 언제든 환영입니다."
   }
  ]
 },
 {
  "id": "s26-1",
  "scene": 26,
  "voices": [
   "카멜레온"
  ],
  "lines": [
   {
    "who": "카멜레온",
    "t": "사장님 휴가 어디로 다녀오셨어요?"
   }
  ]
 },
 {
  "id": "s26-2",
  "scene": 26,
  "voices": [
   "바라"
  ],
  "lines": [
   {
    "who": "바라",
    "t": "비밀!"
   }
  ]
 }
]