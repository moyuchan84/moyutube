[
 {
  "id": "s01-0",
  "scene": 1,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "학교 1층 복도 구석,"
   },
   {
    "who": "narr",
    "t": "아무도 관심 없는 커다란 서랍장이 있어요."
   },
   {
    "who": "narr",
    "t": "주인을 잃어버린 물건들이 모여 있는"
   },
   {
    "who": "narr",
    "t": "분실물 보관함이지요."
   }
  ]
 },
 {
  "id": "s02-0",
  "scene": 2,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "보관함 할아버지가 서랍을 열며 기지개를 켜요."
   }
  ]
 },
 {
  "id": "s02-1",
  "scene": 2,
  "voices": [
   "할아버지"
  ],
  "lines": [
   {
    "who": "할아버지",
    "t": "삐걱 삐걱, 아이고 허리야"
   },
   {
    "who": "할아버지",
    "t": "들어오는 물건은 이렇게 쌓이는데 찾아가는 물건은 없으니 원.. 몸이 자꾸 무거워지는구먼"
   }
  ]
 },
 {
  "id": "s03-0",
  "scene": 3,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "분실물들에게는 신기한 비밀이 있어요."
   },
   {
    "who": "narr",
    "t": "주인과 함께한 좋은 기억이 많을수록"
   },
   {
    "who": "narr",
    "t": "주인과 물건이 그 기억을 떠올릴수록"
   },
   {
    "who": "narr",
    "t": "몸에서 반짝반짝 빛이 난다는 거예요."
   }
  ]
 },
 {
  "id": "s04-0",
  "scene": 4,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "그런데 밤마다 무서운 소문이 소곤소곤 들렸어요."
   },
   {
    "who": "narr",
    "t": "분실함에 온 물건들은 매일 밤 자기 빛을 확인하며 마음을 졸였어요."
   }
  ]
 },
 {
  "id": "s04-1",
  "scene": 4,
  "voices": [
   "물건들"
  ],
  "lines": [
   {
    "who": "물건들",
    "t": "동그라미 날에 수레가 오면 쓰레기장으로 끌려간대!"
   },
   {
    "who": "물건들",
    "t": "빛이 꺼진 애들부터 제일 먼저"
   }
  ]
 },
 {
  "id": "s05-0",
  "scene": 5,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "분실물 보관함 옆 벽에 걸린 달력에는"
   },
   {
    "who": "narr",
    "t": "빨간 동그라미가 크게 쳐져 있어요."
   },
   {
    "who": "narr",
    "t": "공책이 떨리는 목소리로 물었어요."
   },
   {
    "who": "narr",
    "t": "노랑 줄넘기가 몸을 돌돌 말았어요."
   }
  ]
 },
 {
  "id": "s05-1",
  "scene": 5,
  "voices": [
   "공책"
  ],
  "lines": [
   {
    "who": "공책",
    "t": "그 날이 다가오고 있어!"
   }
  ]
 },
 {
  "id": "s05-2",
  "scene": 5,
  "voices": [
   "줄넘기"
  ],
  "lines": [
   {
    "who": "줄넘기",
    "t": "덜덜덜…우리를 쓰레기장에 버리는 날이 분명해."
   }
  ]
 },
 {
  "id": "s06-0",
  "scene": 6,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "파랑 우산이 조용히 속삭이듯 말했어요."
   }
  ]
 },
 {
  "id": "s06-1",
  "scene": 6,
  "voices": [
   "우산"
  ],
  "lines": [
   {
    "who": "우산",
    "t": "지난겨울 동그라미 날에 목도리랑 물통이 수레에 실려 간 뒤로 아무도 돌아오지 않았대. 그날 아침 멀리서 음악 소리가 났는데, 다들 무서워서 귀를 막고 있었대."
   }
  ]
 },
 {
  "id": "s07-0",
  "scene": 7,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "삐뚤빼뚤 기발한 괴물들이 잔뜩 그려진 공책은"
   },
   {
    "who": "narr",
    "t": "아직 환하게 빛이 나고 있어요."
   },
   {
    "who": "narr",
    "t": "공책 주인 지훈이가 공책을 잃어버린 뒤"
   },
   {
    "who": "narr",
    "t": "매일매일 슬퍼하고 있거든요."
   }
  ]
 },
 {
  "id": "s07-1",
  "scene": 7,
  "voices": [
   "공책"
  ],
  "lines": [
   {
    "who": "공책",
    "t": "난 아직 끄떡없어!"
   }
  ]
 },
 {
  "id": "s08-0",
  "scene": 8,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "노랑 줄넘기도 반짝거려요."
   },
   {
    "who": "narr",
    "t": "처음 줄넘기 열개를 성공한 날,"
   },
   {
    "who": "narr",
    "t": "주인 은서의 뿌듯해하던 얼굴이 생각났거든요."
   },
   {
    "who": "narr",
    "t": "줄넘기는 은서가 신던 비슷한 실내화만 지나가도"
   },
   {
    "who": "narr",
    "t": "‘은서 실내화다!’ 하며 목을 길게 뺀답니다."
   }
  ]
 },
 {
  "id": "s09-0",
  "scene": 9,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "하지만 모두가 반짝이는 건 아니에요."
   },
   {
    "who": "narr",
    "t": "파랑우산은 벌써 몇 달 째 주인을 기다리고 있어요."
   },
   {
    "who": "narr",
    "t": "기다리고 또 기다리다 지쳐서"
   },
   {
    "who": "narr",
    "t": "좋은 기억이 자꾸만 흐릿해지고,"
   },
   {
    "who": "narr",
    "t": "빛도 점점 꺼져 가요."
   }
  ]
 },
 {
  "id": "s10-0",
  "scene": 10,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "잠바도 소매를 축 늘어트린 채 걱정이 태산이에요."
   }
  ]
 },
 {
  "id": "s10-1",
  "scene": 10,
  "voices": [
   "잠바"
  ],
  "lines": [
   {
    "who": "잠바",
    "t": "우리 주인이 쑥쑥 자라서 내가 작아지기 전에 날 찾으러 와야 할 텐데…"
   }
  ]
 },
 {
  "id": "s11-0",
  "scene": 11,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "낮이 되면 복도가 시끌시끌해요."
   },
   {
    "who": "narr",
    "t": "벽에는 안내문이 붙어 있어요."
   },
   {
    "who": "narr",
    "t": "하지만 아이들은"
   },
   {
    "who": "narr",
    "t": "안내문도, 보관함도 그냥 지나쳐 가요."
   },
   {
    "who": "narr",
    "t": "동그라미 날은 분실물 정리의 날! 그 전에 꼭 찾아가세요."
   }
  ]
 },
 {
  "id": "s11-1",
  "scene": 11,
  "voices": [
   "아이"
  ],
  "lines": [
   {
    "who": "아이",
    "t": "어차피 엄마가 또 사 주시는데 뭐"
   }
  ]
 },
 {
  "id": "s12-0",
  "scene": 12,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "온 몸에 지저분한 낙서가 가득한 필통은 빛이 가장 흐릿했어요."
   },
   {
    "who": "narr",
    "t": "주인이었던 도윤이는"
   },
   {
    "who": "narr",
    "t": "필통에 마구 낙서를 하고,"
   },
   {
    "who": "narr",
    "t": "심심하면 바닥에 던졌거든요."
   }
  ]
 },
 {
  "id": "s13-0",
  "scene": 13,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "필통은 어두운 구석에 웅크린 채 작게 중얼거렸어요."
   }
  ]
 },
 {
  "id": "s13-1",
  "scene": 13,
  "voices": [
   "필통"
  ],
  "lines": [
   {
    "who": "필통",
    "t": "난 차라리 이 서랍 안이 마음이 훨씬 편해. 그 애가 날 다시 찾으러 올까 봐 겁이 나..."
   }
  ]
 },
 {
  "id": "s14-0",
  "scene": 14,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "그 때 “파앗…!”하고 작은 소리가 났어요."
   },
   {
    "who": "narr",
    "t": "파랑우산의 빛이 한번 깜박이더니 거의 꺼져 가고 있었어요."
   }
  ]
 },
 {
  "id": "s15-0",
  "scene": 15,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "공책이 다가와 말했어요."
   },
   {
    "who": "narr",
    "t": "우산은 힘없이 웃으며 말했어요."
   },
   {
    "who": "narr",
    "t": "그러자 우산의 빛이 다시 살아나기 시작했어요."
   }
  ]
 },
 {
  "id": "s15-1",
  "scene": 15,
  "voices": [
   "공책"
  ],
  "lines": [
   {
    "who": "공책",
    "t": "기억해야 해! 네가 얼마나 사랑받았는지!"
   }
  ]
 },
 {
  "id": "s15-2",
  "scene": 15,
  "voices": [
   "우산"
  ],
  "lines": [
   {
    "who": "우산",
    "t": "내 주인 민준이는 비 오는 날이 제일 좋다고 했어. 나를 펼치고 낙하산 타는 흉내를 내기도 했지…"
   }
  ]
 },
 {
  "id": "s16-0",
  "scene": 16,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "필통이 말했어요."
   },
   {
    "who": "narr",
    "t": "공책이 말해주었어요."
   }
  ]
 },
 {
  "id": "s16-1",
  "scene": 16,
  "voices": [
   "필통"
  ],
  "lines": [
   {
    "who": "필통",
    "t": "좋겠다..기억하면 빛이 돌아오는구나. 나는 좋은 기억이 없어. 아프기만 했는데."
   }
  ]
 },
 {
  "id": "s16-2",
  "scene": 16,
  "voices": [
   "공책"
  ],
  "lines": [
   {
    "who": "공책",
    "t": "그래도 네 빛이 아직 남아 있다는 건 분명 좋은 기억이 있다는 거야"
   }
  ]
 },
 {
  "id": "s16-3",
  "scene": 16,
  "voices": [
   "필통"
  ],
  "lines": [
   {
    "who": "필통",
    "t": "정말..그런 걸까..."
   }
  ]
 },
 {
  "id": "s17-0",
  "scene": 17,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "마침내 동그라미 날 아침이 밝았어요."
   },
   {
    "who": "narr",
    "t": "현관 밖에서 수레가 덜컹덜컹 다가와요."
   },
   {
    "who": "narr",
    "t": "물건들은 수레에 실렸어요."
   }
  ]
 },
 {
  "id": "s17-1",
  "scene": 17,
  "voices": [
   "물건들"
  ],
  "lines": [
   {
    "who": "물건들",
    "t": "쓰레기장으로 가는 수레다! 조심해!"
   },
   {
    "who": "물건들",
    "t": "우린 이제 정말...끝인가봐."
   }
  ]
 },
 {
  "id": "s18-0",
  "scene": 18,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "그런데 이상했어요."
   },
   {
    "who": "narr",
    "t": "물수건으로 먼지와 낙서가 쓱쓱 닦이고,"
   },
   {
    "who": "narr",
    "t": "곁에서는"
   },
   {
    "who": "narr",
    "t": "사각사각 연필로 뭔가를 쓰는 소리가 들렸어요."
   }
  ]
 },
 {
  "id": "s19-0",
  "scene": 19,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "무서워서 눈을 질끈 감고 있었던 물건들은"
   },
   {
    "who": "narr",
    "t": "하나 둘 눈을 떠보고 깜짝 놀랐어요."
   },
   {
    "who": "narr",
    "t": "물건들은 반듯하게 전시장 위에 올려져 있었거든요."
   },
   {
    "who": "narr",
    "t": "그때 학교 안내방송이 흘러 나왔어요."
   }
  ]
 },
 {
  "id": "s19-1",
  "scene": 19,
  "voices": [
   "방송"
  ],
  "lines": [
   {
    "who": "방송",
    "t": "오늘은 분실물 패션쇼와 나눔 바자회가 열리는 날입니다. 원래 주인은 물건을 찾아갈 수 있고, 주인을 찾지 못한 물건은 새 주인을 만납니다. 모인 기부금은 어려운 이웃을 돕는데 쓰입니다."
   }
  ]
 },
 {
  "id": "s20-0",
  "scene": 20,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "음악이 흐르고 패션쇼가 시작 되었어요."
   },
   {
    "who": "narr",
    "t": "옷, 모자 신발 같은 물건들이 무대에 올라가요."
   },
   {
    "who": "narr",
    "t": "잠바는 멋지게 펄럭이며 뽐냈고"
   },
   {
    "who": "narr",
    "t": "모자는 신이 나서 윙크를 했어요."
   },
   {
    "who": "narr",
    "t": "축구화는 튼튼한 바닥을 드러내며 슛 포즈를 취했어요."
   }
  ]
 },
 {
  "id": "s21-0",
  "scene": 21,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "무대 아래에서 구경하던 아이들이 감탄했어요."
   }
  ]
 },
 {
  "id": "s21-1",
  "scene": 21,
  "voices": [
   "아이"
  ],
  "lines": [
   {
    "who": "아이",
    "t": "우와!"
   },
   {
    "who": "아이",
    "t": "나 저거 갖고 싶었던 건데"
   }
  ]
 },
 {
  "id": "s22-0",
  "scene": 22,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "전시대 물건 옆에는"
   },
   {
    "who": "narr",
    "t": "정성스럽게 쓴 이름표 카드가 놓여 있어요."
   },
   {
    "who": "narr",
    "t": "이름: 괴물 아이템 공책. 특기: 기발한 괴물 그림이 가득해요. 기다린 시간: 15일."
   },
   {
    "who": "narr",
    "t": "이름: 노랑이 줄넘기. 특기: 가볍고 날렵해요."
   }
  ]
 },
 {
  "id": "s23-0",
  "scene": 23,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "필통이 놓인 전시대 앞에 발걸음들이 하나 둘 멈춰요."
   },
   {
    "who": "narr",
    "t": "정성껏 닦고 리본까지 달았지만, 지워지지 않은 낙서가 있어요."
   },
   {
    "who": "narr",
    "t": "아이들은 가져갈 생각은 하지 않고 수군거렸어요."
   },
   {
    "who": "narr",
    "t": "필통은 무대 위에서 멋지게 포즈를 취하는 물건들을 보며 슬퍼했어요."
   },
   {
    "who": "narr",
    "t": "이름: 통통이. 특이사항: 상처가 많아요. 아팠을 거예요."
   }
  ]
 },
 {
  "id": "s23-1",
  "scene": 23,
  "voices": [
   "아이"
  ],
  "lines": [
   {
    "who": "아이",
    "t": "자기 필통을 이렇게까지 지저분하게 쓴다고? 말도 안돼."
   }
  ]
 },
 {
  "id": "s23-2",
  "scene": 23,
  "voices": [
   "필통"
  ],
  "lines": [
   {
    "who": "필통",
    "t": "여기서도 난 희망이 없구나.."
   }
  ]
 },
 {
  "id": "s24-0",
  "scene": 24,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "그 말을 옆에서 누군가 조용히 듣고 있었어요."
   },
   {
    "who": "narr",
    "t": "필통의 주인이었던 도윤이었어요."
   },
   {
    "who": "narr",
    "t": "이름표를 끝까지 읽자 가슴이 쿵 내려앉아요."
   },
   {
    "who": "narr",
    "t": "귀까지 빨개져서 모자를 푹 눌러썼어요."
   }
  ]
 },
 {
  "id": "s25-0",
  "scene": 25,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "한 아이가 필통을 조심스럽게 들어 올렸어요."
   },
   {
    "who": "narr",
    "t": "도윤이는 처음 필통을 샀을 때"
   },
   {
    "who": "narr",
    "t": "날아갈 듯 기뻤던 마음이 떠올랐어요."
   },
   {
    "who": "narr",
    "t": "그 순간,"
   },
   {
    "who": "narr",
    "t": "빛이 꺼져가던 필통의 몸에서"
   },
   {
    "who": "narr",
    "t": "세상 그 어떤 보석보다 화려하고 눈부신 빛이 뿜어져 나왔어요."
   }
  ]
 },
 {
  "id": "s25-1",
  "scene": 25,
  "voices": [
   "여자아이"
  ],
  "lines": [
   {
    "who": "여자아이",
    "t": "어? 냥냥이다! 내가 제일 좋아하는 캐릭터! 이 색은 처음 봐!"
   }
  ]
 },
 {
  "id": "s25-2",
  "scene": 25,
  "voices": [
   "도윤"
  ],
  "lines": [
   {
    "who": "도윤",
    "t": "아…맞다..나도 저거 갖고 싶어서 엄마한테 졸라서 산 거였는데"
   }
  ]
 },
 {
  "id": "s26-0",
  "scene": 26,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "도윤이가 모자를 벗고 앞으로 나왔어요."
   },
   {
    "who": "narr",
    "t": "필통은 깜짝 놀라 몸을 움츠리며 생각했어요."
   },
   {
    "who": "narr",
    "t": "도윤이는 필통을 두 손으로 조심조심 받았어요."
   }
  ]
 },
 {
  "id": "s26-1",
  "scene": 26,
  "voices": [
   "도윤"
  ],
  "lines": [
   {
    "who": "도윤",
    "t": "잠깐만! 그거…내 거야."
   }
  ]
 },
 {
  "id": "s26-2",
  "scene": 26,
  "voices": [
   "필통"
  ],
  "lines": [
   {
    "who": "필통",
    "t": "또 던지면 어떡하지…"
   }
  ]
 },
 {
  "id": "s27-0",
  "scene": 27,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "도윤이는 필통을 꼭 안았어요."
   },
   {
    "who": "narr",
    "t": "필통은 도윤이를 처음 만났을 때의 따뜻함이 기억났어요."
   },
   {
    "who": "narr",
    "t": "필통을 가지고 있던 아이는"
   },
   {
    "who": "narr",
    "t": "도윤이에게 건네며 활짝 웃었어요."
   }
  ]
 },
 {
  "id": "s27-1",
  "scene": 27,
  "voices": [
   "도윤"
  ],
  "lines": [
   {
    "who": "도윤",
    "t": "미안해. 또 새로운 걸 사면된다고 생각하고 함부로 했어. 그런데 다시 널 보니 생각이 났어. 내가 널 얼마나 좋아했는지."
   }
  ]
 },
 {
  "id": "s27-2",
  "scene": 27,
  "voices": [
   "여자아이"
  ],
  "lines": [
   {
    "who": "여자아이",
    "t": "주인이 있었구나, 다행이다!"
   }
  ]
 },
 {
  "id": "s28-0",
  "scene": 28,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "그날, 다른 주인들도 하나 둘 찾아왔어요."
   },
   {
    "who": "narr",
    "t": "지훈이는 괴물 공책을 친구들에게 보여주며"
   },
   {
    "who": "narr",
    "t": "자신의 그림을 자랑했고,"
   },
   {
    "who": "narr",
    "t": "은서는 노랑 줄넘기를 보자마자"
   },
   {
    "who": "narr",
    "t": "콩콩 뛰었어요."
   },
   {
    "who": "narr",
    "t": "민준이는 파랑우산을 펼치며"
   },
   {
    "who": "narr",
    "t": "낙하산 타는 흉내를 냈어요."
   },
   {
    "who": "narr",
    "t": "잠바를 입어보더니 주인은"
   }
  ]
 },
 {
  "id": "s28-1",
  "scene": 28,
  "voices": [
   "아이"
  ],
  "lines": [
   {
    "who": "아이",
    "t": "딱 맞네!"
   }
  ]
 },
 {
  "id": "s29-0",
  "scene": 29,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "새 주인을 만난 물건들도 있었어요."
   },
   {
    "who": "narr",
    "t": "모자와 축구화가 새 친구의 품에서 반짝였어요."
   },
   {
    "who": "narr",
    "t": "저 멀리 복도에서는 지난겨울 떠난 목도리와 물통이"
   },
   {
    "who": "narr",
    "t": "새 주인과 함께 손을 흔들고 있었어요."
   }
  ]
 },
 {
  "id": "s30-0",
  "scene": 30,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "그 날 이후,"
   },
   {
    "who": "narr",
    "t": "분실물 보관함의 많은 것이 변했어요."
   },
   {
    "who": "narr",
    "t": "아이들은 무언가를 잃어버리면"
   },
   {
    "who": "narr",
    "t": "가장 먼저 보관함으로 달려와요."
   },
   {
    "who": "narr",
    "t": "도윤이는 필통부터 챙기는 습관이 생겼답니다."
   }
  ]
 },
 {
  "id": "s31-0",
  "scene": 31,
  "voices": [
   "narr"
  ],
  "lines": [
   {
    "who": "narr",
    "t": "분실물보관함 할아버지가 웃으며 말해요."
   },
   {
    "who": "narr",
    "t": "오늘도 분실물 보관함의 물건들은"
   },
   {
    "who": "narr",
    "t": "주인을 기다리며"
   },
   {
    "who": "narr",
    "t": "사랑받은 기억으로"
   },
   {
    "who": "narr",
    "t": "빛을 내고 있어요."
   }
  ]
 },
 {
  "id": "s31-1",
  "scene": 31,
  "voices": [
   "할아버지"
  ],
  "lines": [
   {
    "who": "할아버지",
    "t": "이제 몸이 좀 가벼워졌군 허허"
   }
  ]
 }
]