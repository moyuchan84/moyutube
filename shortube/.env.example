# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.

# YouTube Data API v3 (Phase 4) — Google Cloud Console > API 및 서비스 > YouTube Data API v3 사용 설정 > 사용자 인증 정보 > API 키
YOUTUBE_API_KEY=

# 네이버 DataLab 검색어트렌드 (Phase 3) — developers.naver.com > 애플리케이션 등록 > 사용 API: 데이터랩(검색어트렌드)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Wikimedia API User-Agent에 넣을 연락처 (Phase 2) — 이메일 또는 프로젝트 URL
WIKIMEDIA_CONTACT=
