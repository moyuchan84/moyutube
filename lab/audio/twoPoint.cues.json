 "caps": [
  {
   "t": 4.655,
   "kind": "say",
   "text": "연필 두 자루를 나란히 붙여\n뭉툭한 쪽을 아래로"
  },
  {
   "t": 6.725,
   "kind": "say",
   "text": "친구는 눈을 감아요"
  },
  {
   "t": 8.575,
   "kind": "say",
   "text": "살짝 누르고 물어봐요\n\"하나? 둘?\""
  },
  {
   "t": 10.525,
   "kind": "say",
   "text": "뾰족한 쪽은 절대 쓰지 마세요!"
  },
  {
   "t": 13.895,
   "kind": "say",
   "text": "먼저 손끝을 살짝"
  },
  {
   "t": 16.895,
   "kind": "say",
   "text": "\"둘!\" 두 점이 느껴져요"
  },
  {
   "t": 18.895,
   "kind": "say",
   "text": "이번엔 팔뚝을 똑같이"
  },
  {
   "t": 21.895,
   "kind": "say",
   "text": "어? 하나뿐인 것 같아요!"
  },
  {
   "t": 25.895,
   "kind": "say",
   "text": "똑같은 연필 두 자루인데!"
  },
  {
   "t": 29.465,
   "kind": "say",
   "text": "피부에는 닿는 걸 느끼는\n세포가 구역을 나눠 맡아요"
  },
  {
   "t": 31.835,
   "kind": "say",
   "text": "손끝은 빽빽해서\n두 점이 다른 세포에 닿아요"
  },
  {
   "t": 34.335,
   "kind": "say",
   "text": "팔뚝은 듬성듬성해서\n두 점이 한 세포에 같이 닿아요"
  },
  {
   "t": 36.835,
   "kind": "say",
   "text": "한 세포가 보낸 신호는 하나\n→ 뇌는 \"한 점\"이라고 느껴요"
