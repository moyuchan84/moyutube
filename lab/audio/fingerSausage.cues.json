 "caps": [
  {
   "t": 5.41,
   "kind": "say",
   "text": "두 검지 끝을 눈앞 한 뼘에서\n맞대요"
  },
  {
   "t": 7.18,
   "kind": "say",
   "text": "손가락 말고\n먼 벽을 보세요"
  },
  {
   "t": 9.13,
   "kind": "say",
   "text": "손가락을 살짝 떼면?"
  },
  {
   "t": 12.48,
   "kind": "say",
   "text": "지금 해 보세요!\n눈은 먼 곳에"
  },
  {
   "t": 16.25,
   "kind": "say",
   "text": "손가락 사이에\n뭐가 떠 있나요?"
  },
  {
   "t": 19.25,
   "kind": "say",
   "text": "손가락을 더 떼면\n소시지가 줄어요"
  },
  {
   "t": 23.25,
   "kind": "say",
   "text": "공중에 뜬 손가락 소시지!"
  },
  {
   "t": 26.82,
   "kind": "say",
   "text": "위에서 내려다보면\n두 눈은 조금 떨어져 있어요"
  },
  {
   "t": 28.89,
   "kind": "say",
   "text": "먼 곳을 볼 때 가까운 손가락은\n눈마다 다른 자리에 보여요"
  },
  {
   "t": 33.56,
   "kind": "say",
   "text": "왼눈 그림과 오른눈 그림을"
  },
  {
   "t": 35.13,
   "kind": "say",
   "text": "뇌가 하나로 겹치면"
  },
  {
   "t": 36.63,
   "kind": "say",
   "text": "두 손가락 끝이 겹친 곳 = 소시지!"
  },
  {
   "t": 38.8,
   "kind": "say",
   "text": "한쪽 눈을 감으면?\n겹칠 그림이 없어 사라져요"
  },
  {
   "t": 41.57,
   "kind": "say",
   "text": "이렇게 두 그림을 겹쳐서\n멀고 가까움을 알아요"
  },
  {
   "t": 45.14,
   "kind": "say",
   "text": "이걸 \"입체시\"라고 해요"
  },
  {
