 "caps": [
  {
   "t": 4.805,
   "kind": "say",
   "text": "넓은 접시에\n물을 얕게 부어요"
  },
  {
   "t": 6.875,
   "kind": "say",
   "text": "후추를 솔솔\n골고루 뿌려요"
  },
  {
   "t": 9.025,
   "kind": "say",
   "text": "손가락 끝에\n주방 세제를 콕"
  },
  {
   "t": 11.175,
   "kind": "say",
   "text": "세제는 눈에 닿지 않게,\n끝나면 손 씻기!"
  },
  {
   "t": 14.745,
   "kind": "say",
   "text": "먼저 맨 손가락으로 콕"
