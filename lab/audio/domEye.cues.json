 "caps": [
  {
   "t": 4.735,
   "kind": "say",
   "text": "두 손을 겹쳐\n세모 구멍을 만들어요"
  },
  {
   "t": 6.505,
   "kind": "say",
   "text": "팔을 뻗고, 두 눈으로\n먼 물건을 구멍 가운데에"
  },
  {
   "t": 8.655,
   "kind": "say",
   "text": "그리고 한쪽씩 눈을 감아요"
  },
  {
   "t": 11.905,
   "kind": "say",
   "text": "두 눈을 뜨고\n물건을 구멍 가운데에"
  },
  {
   "t": 15.675,
   "kind": "say",
   "text": "왼눈을 감아 보세요"
  },
  {
   "t": 19.675,
   "kind": "say",
   "text": "이번엔 오른눈을 감아요"
  },
  {
   "t": 24.675,
   "kind": "say",
   "text": "물건이 그대로일 때\n뜨고 있던 눈 = 주인 눈!"
  },
  {
   "t": 28.445,
   "kind": "say",
   "text": "물건을 구멍에 맞출 때\n뇌는 한쪽 눈을 기준으로 해요"
  },
  {
   "t": 30.865,
   "kind": "say",
   "text": "다른 눈으로 보면\n구멍 밖으로 빗나가요"
  },
  {
   "t": 33.935,
   "kind": "say",
   "text": "오른손잡이 · 왼손잡이처럼 눈도\n주로 쓰는 쪽이 있어요"
  },
  {
   "t": 36.105,
   "kind": "say",
   "text": "오른눈이 주인인 사람이\n더 많아요"
  },
  {
   "t": 39.475,
   "kind": "say",
   "text": "망원경이나 카메라를 볼 때\n저절로 주인 눈을 대요"
