 "caps": [
  {
   "t": 4.34,
   "kind": "say",
   "text": "소용돌이 가운데 점을\n20초 동안 보세요"
  },
  {
   "t": 6.11,
   "kind": "say",
   "text": "끝나면 손바닥 그림 → 진짜 손바닥"
  },
  {
   "t": 7.48,
   "kind": "say",
   "text": "어지러우면 바로 멈추세요"
  },
  {
   "t": 10.05,
   "kind": "say",
   "text": "가운데 점에서 눈을 떼지 마세요"
  },
  {
   "t": 18.82,
   "kind": "say",
   "text": "조금만 더!"
  },
  {
   "t": 25.82,
   "kind": "say",
   "text": "끝나도 계속 가운데를 보세요"
  },
  {
   "t": 30.82,
   "kind": "say",
   "text": "손바닥이 부풀어 꿈틀대죠?"
  },
  {
   "t": 33.99,
   "kind": "say",
   "text": "이제 진짜 내 손바닥을 봐요!"
  },
  {
   "t": 37.96,
   "kind": "say",
   "text": "움직임을 알아채는 세포는\n두 팀이 줄다리기를 해요"
  },
  {
   "t": 39.93,
   "kind": "say",
   "text": "힘이 같으면\n멈춘 건 멈춰 보여요"
  },
  {
   "t": 41.7,
   "kind": "say",
   "text": "안으로 도는 걸 20초 보면\n'안으로' 팀이 지쳐요"
  },
  {
   "t": 43.967,
   "kind": "say",
   "text": "멈춘 걸 보면 '바깥으로' 팀이 이겨서"
  },
  {
   "t": 48.267,
   "kind": "say",
   "text": "폭포를 오래 보다가 바위를 보면?"
  },
  {
   "t": 50.237,
   "kind": "say",
   "text": "바위가 위로 올라가 보여요\n그래서 이름이 폭포 착시!"
  },
  {
   "t": 54.037,
   "kind": "say",
   "text": "잠깐 지나면 금방 돌아와요"
  },
  {
   "t": 56.087,
   "kind": "hide",
   "text": ""
  },
  {
   "t": 56.087,
   "kind": "end",
   "text": "흑백 그림이\n컬러로 보인다?"
