 "caps": [
  {
   "t": 3.415,
   "kind": "say",
   "text": "가운데 선만 보세요\n위와 아래, 어느 쪽이 길까요?"
  },
  {
   "t": 9.185,
   "kind": "say",
   "text": "아래 선이 더 길어 보이죠?"
  },
  {
   "t": 11.555,
   "kind": "say",
   "text": "위 선의 끝에서\n세로줄을 쭉 내려 볼게요"
  },
  {
   "t": 13.925,
   "kind": "say",
   "text": "어? 아래 선 끝에\n딱 맞아요!"
  },
  {
   "t": 16.095,
   "kind": "say",
   "text": "자를 대 볼까요?"
  },
  {
   "t": 18.165,
   "kind": "say",
   "text": "둘 다 똑같이 10칸!"
  },
  {
   "t": 20.535,
   "kind": "say",
   "text": "꺾쇠를 떼어 내면"
  },
  {
   "t": 22.635,
   "kind": "say",
   "text": "그냥 같은 길이의 두 선"
  },
  {
   "t": 25.605,
   "kind": "say",
   "text": "다시 붙이면…\n알고 봐도 또 아래가 길어 보여요!"
  },
  {
   "t": 28.575,
   "kind": "say",
   "text": "뇌는 가운데 선만\n따로 재지 않아요"
  },
  {
   "t": 30.745,
   "kind": "say",
   "text": "끝에 붙은 모양까지\n한 덩어리로 보고 길이를 짐작해요"
  },
  {
   "t": 33.515,
   "kind": "say",
   "text": "벌어진 끝은 덩어리가 크니까\n선도 길다고 느껴요"
  },
  {
   "t": 36.285,
   "kind": "say",
   "text": "정확히 왜 그런지는\n과학자들도 아직 연구 중이에요"
  },
  {
   "t": 40.255,
   "kind": "say",
   "text": "종이에 똑같이 그려서\n친구에게 물어보세요"
  },
  {
   "t": 44.425,
   "kind": "say",
   "text": "같은 길이도 끝 모양에 따라\n다르게 보여요"
  },
